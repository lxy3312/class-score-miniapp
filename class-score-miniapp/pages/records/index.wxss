.records-page { padding-top: 30rpx; }
.load-state, .viewer-note { margin: 0 0 16rpx; padding: 16rpx 20rpx; border-radius: 14rpx; color: #5f6e84; background: #f2f5fa; font-size: 22rpx; line-height: 1.45; }
.load-error { color: #b94f58; background: #fff0f1; }
.viewer-note { color: #56627a; background: #eef1ff; }
.page-topline { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24rpx; }
.page-kicker { color: #3157d5; font-size: 19rpx; font-weight: 750; letter-spacing: 3rpx; }
.page-subtitle { margin-top: 7rpx; color: #8f9aaa; font-size: 22rpx; }
.header-count { display: flex; align-items: baseline; gap: 4rpx; color: #3157d5; }
.header-count text:first-child { font-size: 42rpx; font-weight: 750; font-variant-numeric: tabular-nums; }
.header-count text:last-child { color: #8f9aaa; font-size: 22rpx; }
.filter-tabs { display: flex; padding: 8rpx; }
.filter-tab { flex: 1; padding: 16rpx 0; border-radius: 14rpx; color: #919bab; text-align: center; font-size: 25rpx; }
.filter-tab.active { color: #3157d5; background: #eef1ff; font-weight: 700; }
.filter-tab.active.add { color: #15986a; background: #eaf8f1; }
.filter-tab.active.deduct { color: #df646b; background: #fff0f1; }
.notice-bar { display: flex; align-items: center; margin: 22rpx 0 30rpx; padding: 17rpx 20rpx; border: 1rpx solid #dce8ff; border-radius: 16rpx; background: #f0f5ff; }
.notice-icon { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; margin-right: 13rpx; border-radius: 14rpx; color: #3157d5; background: #dbe6ff; font-size: 27rpx; }
.notice-title { display: block; color: #3157d5; font-size: 23rpx; font-weight: 650; }
.notice-copy { display: block; margin-top: 3rpx; color: #7c91bb; font-size: 20rpx; }
.notice-live { margin-left: auto; padding: 7rpx 12rpx; border-radius: 999rpx; color: #15986a; background: #dff6ea; font-size: 19rpx; }
.timeline { padding-bottom: 30rpx; }
.date-label { display: flex; align-items: center; gap: 14rpx; margin: 20rpx 0 14rpx; color: #96a1b1; font-size: 21rpx; }
.date-line { flex: 1; height: 1rpx; background: #e4e8ef; }
.event-card { display: flex; align-items: center; min-height: 124rpx; margin-bottom: 14rpx; padding: 19rpx 20rpx; }
.event-card.voided { opacity: .52; }
.event-avatar { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 70rpx; height: 70rpx; border-radius: 23rpx; color: #fff; font-size: 28rpx; font-weight: 700; }
.event-content { flex: 1; min-width: 0; margin-left: 16rpx; }
.event-title { display: flex; align-items: baseline; min-width: 0; }
.event-member { color: #17202a; font-size: 27rpx; font-weight: 700; }
.event-reason { overflow: hidden; max-width: 280rpx; margin-left: 12rpx; color: #6f7c90; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.event-meta { overflow: hidden; margin-top: 7rpx; color: #a0a9b8; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.event-note { overflow: hidden; margin-top: 8rpx; color: #8a95a6; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.event-right { display: flex; flex-direction: column; align-items: flex-end; margin-left: 10rpx; }
.event-delta { font-size: 34rpx; font-weight: 750; font-variant-numeric: tabular-nums; }
.undo, .void-label { margin-top: 8rpx; color: #9aa4b3; font-size: 20rpx; }
.undo { color: #3157d5; }
.event-actions { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; white-space: nowrap; }
.event-action { color: #3157d5; font-size: 18rpx; }
.event-action.edit { color: #5b6fc7; }
.event-action.delete { color: #d95f68; }
.fab { position: fixed; right: 30rpx; bottom: calc(118rpx + env(safe-area-inset-bottom)); z-index: 5; display: flex; align-items: center; height: 88rpx; padding: 0 25rpx 0 18rpx; border-radius: 999rpx; color: #fff; background: linear-gradient(135deg, #3157d5, #6557d6); box-shadow: 0 14rpx 28rpx rgba(49,87,213,.28); font-size: 25rpx; font-weight: 650; }
.fab-plus { display: inline-flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-right: 8rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); font-size: 35rpx; font-weight: 300; }
.sheet-mask { position: fixed; inset: 0; z-index: 20; display: flex; align-items: flex-end; background: rgba(19, 29, 53, .48); }
.composer { width: 100%; max-height: 91vh; overflow-y: auto; padding: 18rpx 30rpx 0; border-radius: 28rpx 28rpx 0 0; background: #fff; box-shadow: 0 -10rpx 40rpx rgba(20, 31, 67, .18); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 99rpx; background: #dfe4ed; }
.composer-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 22rpx; }
.close-btn { width: 52rpx; height: 52rpx; border-radius: 99rpx; color: #7f8a9b; background: #f3f5f8; font-size: 36rpx; line-height: 48rpx; text-align: center; }
.form-label { margin: 19rpx 0 10rpx; color: #58657a; font-size: 23rpx; font-weight: 650; }
.picker-field, .picker-simple { display: flex; align-items: center; height: 78rpx; padding: 0 20rpx; border: 1rpx solid #e5e9f1; border-radius: 15rpx; color: #17202a; font-size: 26rpx; }
.picker-avatar { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-right: 12rpx; border-radius: 16rpx; color: #fff; font-size: 21rpx; font-weight: 700; }
.picker-arrow { margin-left: auto; color: #9aa5b5; font-size: 28rpx; }
.mode-switch { display: flex; gap: 12rpx; margin-top: 18rpx; padding: 6rpx; border-radius: 16rpx; background: #f4f6fa; }
.mode-btn { flex: 1; padding: 15rpx 0; border-radius: 12rpx; color: #919bab; text-align: center; font-size: 25rpx; font-weight: 650; }
.selected-add { color: #15986a; background: #fff; box-shadow: 0 3rpx 10rpx rgba(37, 76, 66, .08); }
.selected-deduct { color: #df646b; background: #fff; box-shadow: 0 3rpx 10rpx rgba(122, 46, 54, .08); }
.points-label { margin-top: 16rpx; }
.quick-row { display: flex; align-items: center; gap: 12rpx; }
.quick-chip { flex: 1; padding: 15rpx 0; border: 1rpx solid #dfe6f1; border-radius: 13rpx; text-align: center; font-size: 25rpx; font-weight: 700; }
.chip-add { color: #15986a; background: #f2fbf7; }
.chip-deduct { color: #df646b; background: #fff6f6; }
.quick-chip.chosen { border-color: currentColor; box-shadow: 0 0 0 2rpx currentColor inset; }
.custom-points { flex: 1.25; height: 57rpx; padding: 0 13rpx; border: 1rpx solid #dfe6f1; border-radius: 13rpx; color: #17202a; font-size: 23rpx; text-align: center; }
.picker-simple { gap: 10rpx; }
.picker-simple text:first-child { color: #3157d5; font-size: 30rpx; }
.required { color: #e36369; }
.text-field, .note-field { width: 100%; border: 1rpx solid #e5e9f1; border-radius: 15rpx; color: #17202a; font-size: 25rpx; }
.text-field { height: 78rpx; padding: 0 20rpx; }
.note-field { min-height: 120rpx; padding: 16rpx 20rpx; }
.reason-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.reason-chip { padding: 8rpx 14rpx; border-radius: 999rpx; color: #65738a; background: #f1f4f9; font-size: 20rpx; }
.submit-btn { margin-top: 24rpx; height: 88rpx; line-height: 88rpx; }
.safe-bottom-space { height: calc(22rpx + env(safe-area-inset-bottom)); }
.records-page { padding-top: 22rpx; }.header-count text:first-child { font-size: 30rpx; }.header-count text:last-child { font-size: 19rpx; }.filter-tab { padding: 13rpx 0; font-size: 22rpx; }.timeline { padding-bottom: 20rpx; }.event-card { min-height: 112rpx; padding: 15rpx 17rpx; }.event-meta, .event-note { font-size: 18rpx; }.event-delta { font-size: 30rpx; }.undo, .void-label, .event-action { font-size: 18rpx; }

/* Use a stable line box for every selectable/action label. */
.filter-tab, .mode-btn, .quick-chip, .reason-chip, .close-btn, .picker-field, .picker-simple {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  text-align: center;
}
.filter-tab, .mode-btn, .quick-chip, .reason-chip, .close-btn {
  padding-top: 0;
  padding-bottom: 0;
}
.filter-tab { min-height: 52rpx; }
.mode-btn { min-height: 56rpx; }
.quick-chip { min-height: 57rpx; }
.reason-chip { min-height: 42rpx; }
.picker-field, .picker-simple { min-height: 78rpx; }

/* Let names and rule labels yield space to the arrow instead of overflowing. */
.records-page { overflow-x: hidden; }
.picker-field, .picker-simple { justify-content: flex-start; min-width: 0; }
.picker-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker-icon { flex: 0 0 auto; }
.picker-arrow { flex: 0 0 auto; margin-left: auto; }
.reason-chip { max-width: 100%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.quick-chip, .custom-points { min-width: 0; }
.event-content { min-width: 0; }
.event-title { min-width: 0; }
.event-member { flex: 0 0 auto; max-width: 42%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.event-reason { flex: 1; min-width: 0; max-width: none; }
.event-right { flex: 0 0 auto; min-width: 82rpx; }
.event-actions { flex-wrap: wrap; justify-content: flex-end; max-width: 150rpx; }
