.student-page { padding-top: 20rpx; }
.load-state { margin-bottom: 16rpx; padding: 16rpx 20rpx; border-radius: 14rpx; color: #5f6e84; background: #f2f5fa; font-size: 22rpx; line-height: 1.45; }
.load-error { color: #b94f58; background: #fff0f1; }
.student-hero { position: relative; display: flex; flex-direction: column; align-items: center; overflow: hidden; margin: -20rpx -28rpx 0; padding: 35rpx 28rpx 86rpx; color: #fff; background: linear-gradient(145deg, #2448b9, #4057cd 62%, #6b58d4); }
.student-hero::after { content: ''; position: absolute; right: -85rpx; top: -105rpx; width: 240rpx; height: 240rpx; border: 34rpx solid rgba(255,255,255,.07); border-radius: 999rpx; }
.student-avatar { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; border: 7rpx solid rgba(255,255,255,.88); border-radius: 35rpx; color: #fff; font-size: 41rpx; font-weight: 750; box-shadow: 0 12rpx 26rpx rgba(17,33,100,.22); }
.student-name { position: relative; z-index: 1; margin-top: 16rpx; font-size: 38rpx; font-weight: 760; }
.student-group { position: relative; z-index: 1; margin-top: 5rpx; color: rgba(255,255,255,.67); font-size: 21rpx; }
.period-cards { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; margin-top: -57rpx; }
.period-card { min-height: 206rpx; padding: 21rpx 20rpx 17rpx; text-align: center; }
.term-card { background: linear-gradient(180deg, #fff, #faf9ff); }
.period-name { color: #7d899b; font-size: 21rpx; font-weight: 650; }
.period-score { margin-top: 7rpx; font-size: 48rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.period-rank { margin-top: 2rpx; color: #647187; font-size: 20rpx; }
.student-badge { display: inline-flex; align-items: center; max-width: 240rpx; overflow: hidden; margin-top: 10rpx; padding: 5rpx 10rpx; border-radius: 999rpx; color: #91681d; background: #fff7e6; font-size: 16rpx; text-overflow: ellipsis; white-space: nowrap; }
.student-badge text { margin-right: 4rpx; }
.positive { color: #18a06f; }
.negative { color: #e36369; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 30rpx 2rpx 14rpx; }
.section-title { font-size: 30rpx; }
.section-note { color: #9ba5b5; font-size: 18rpx; }
.dimension-list { overflow: hidden; }
.dimension-row { display: flex; align-items: center; min-height: 96rpx; padding: 0 20rpx; border-bottom: 1rpx solid #f0f2f6; }
.dimension-row:last-child { border-bottom: 0; }
.dimension-symbol { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 16rpx; color: #3157d5; background: #eef1ff; font-size: 21rpx; font-weight: 750; }
.symbol-sports { color: #188768; background: #eaf8f3; }
.symbol-labor { color: #b4771f; background: #fff5e6; }
.symbol-discipline { color: #6f5fc2; background: #f2efff; }
.dimension-name { flex: 1; margin-left: 13rpx; color: #263143; font-size: 24rpx; font-weight: 650; }
.dimension-values { display: flex; align-items: center; }
.dimension-values > view { min-width: 90rpx; text-align: right; }
.dimension-label { display: block; color: #a0a9b8; font-size: 16rpx; }
.dimension-score { display: block; margin-top: 3rpx; font-size: 23rpx; font-weight: 730; font-variant-numeric: tabular-nums; }
.student-note { margin-top: 20rpx; color: #a0a9b8; font-size: 18rpx; text-align: center; }

/* Keep the personal view stable for long names and narrow screens. */
.student-page { overflow-x: hidden; }
.student-name { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.period-cards > view { min-width: 0; }
.dimension-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dimension-values { flex: 0 0 auto; }
