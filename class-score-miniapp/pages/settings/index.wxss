.settings-page { padding-top: 30rpx; }
.load-state, .viewer-banner { margin: 0 0 16rpx; padding: 16rpx 20rpx; border-radius: 14rpx; color: #5f6e84; background: #f2f5fa; font-size: 22rpx; line-height: 1.45; }
.load-error { color: #b94f58; background: #fff0f1; }
.viewer-banner { display: flex; flex-direction: column; color: #56627a; background: #eef1ff; }
